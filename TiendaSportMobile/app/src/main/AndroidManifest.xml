<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para consumir la API del backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TiendaSportApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TiendaSportMobile"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic="true": el backend Java corre en HTTP plano (no HTTPS),
             así que Android necesita este permiso explícito para poder conectarse a él
             (desde Android 9 / API 28 en adelante, HTTP sin cifrar está bloqueado por defecto). -->

        <!-- CatalogActivity es ahora la pantalla de inicio: cualquiera puede
             ver el catálogo sin iniciar sesión primero (como pediste). -->
        <activity
            android:name=".ui.catalog.CatalogActivity"
            android:exported="true"
            android:theme="@style/Theme.TiendaSportMobile.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.TiendaSportMobile.NoActionBar" />

        <activity android:name=".ui.register.RegisterActivity" android:exported="false" />
        <!-- CartActivity y OrderConfirmationActivity todavía NO usan el menú lateral
             (eso es un paso futuro), así que conservan su barra de título normal
             — no les pongas el tema NoActionBar todavía o perderían su título. -->
        <activity android:name=".ui.cart.CartActivity" android:exported="false" />
        <activity android:name=".ui.orders.OrderConfirmationActivity" android:exported="false" />
        <activity android:name=".ui.orders.PedidosActivity" android:exported="false" android:theme="@style/Theme.TiendaSportMobile.NoActionBar" />
        <activity android:name=".ui.inventario.InventarioActivity" android:exported="false" android:theme="@style/Theme.TiendaSportMobile.NoActionBar" />
        <activity android:name=".ui.inventario.ProductoFormActivity" android:exported="false" />
        <activity android:name=".ui.categorias.CategoriaActivity" android:exported="false" android:theme="@style/Theme.TiendaSportMobile.NoActionBar" />
        <activity android:name=".ui.usuarios.UsuarioActivity" android:exported="false" android:theme="@style/Theme.TiendaSportMobile.NoActionBar" />
    </application>

</manifest>
